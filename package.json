{
  "name": "going-concern-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "npm run data:archetypes",
    "build": "npm run data:validate && npm run data:archetypes && npm run site:static-css && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:refresh": "node --import tsx scripts/refresh-data.ts",
    "data:validate": "node --import tsx scripts/validate-data.ts",
    "data:archetypes": "node --import tsx scripts/build-archetypes.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "data:publish": "node --import tsx scripts/publish-sec.ts",
    "ceo:balance": "node --import tsx scripts/balance-ceo.ts",
    "test:browser": "node tests/browser.mjs && node tests/ceo-browser.mjs && node tests/course-browser.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "test:live": "node tests/live-browser.mjs",
    "course:keygen": "node --import tsx scripts/course-keygen.ts",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist-server/main.js",
    "server:dev": "node --env-file=.env --import tsx --watch server/main.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "platform:admin": "node --env-file-if-exists=.env --import tsx server/cli/platform-admin.ts",
    "ops:maintenance": "node --env-file-if-exists=.env --import tsx server/cli/maintenance.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test:server": "node --import tsx --test --test-concurrency=1 tests/server/*.test.ts",
    "test:portal": "node tests/portal-browser.cjs",
    "site:static-css": "node scripts/build-static-css.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "@number-flow/react": "^0.6.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "lucide-react": "0.562.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode-generator": "^1.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.8",
    "three": "^0.180.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "rollup": "4.61.1"
  }
}

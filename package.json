{
  "name": "going-concern-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run data:validate && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:refresh": "node --import tsx scripts/refresh-data.ts",
    "data:validate": "node --import tsx scripts/validate-data.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "data:publish": "node --import tsx scripts/publish-sec.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "lucide-react": "0.562.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "rollup": "4.61.1"
  }
}

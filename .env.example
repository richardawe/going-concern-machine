# Copy to shared/.env on the server (chmod 600), or to .env for local development.
# Comments go on their own lines. Quote any value that contains a space.
NODE_ENV=production
# production (or staging, later)
ENVIRONMENT_NAME=production
PORT=3100
WORKERS=2
BASE_DOMAIN=goingconcernlab.com
DATABASE_URL=postgres://gcm:CHANGE_ME@127.0.0.1:5432/gcm_production
# Read-only role that may bypass row-level security, used only by pg_dump for backups
BACKUP_DATABASE_URL=postgres://gcm_backup:CHANGE_ME@127.0.0.1:5432/gcm_production
# openssl rand -base64 48
SESSION_SECRET=
# brevo (Brevo's API) or smtp (any mail server: the server's own cPanel mailbox, Microsoft 365, another provider)
EMAIL_MODE=brevo
# Brevo: SMTP & API, API keys
BREVO_API_KEY=
# For EMAIL_MODE=smtp. Port 465 with SMTP_SECURE=true, or 587 with STARTTLS. EMAIL_FROM must be an address this
# account may send as, and its domain's SPF and DKIM must cover the server that sends.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=sign-in@mail.goingconcernlab.com
EMAIL_FROM_NAME="Going Concern"
# Public contact address, shown on the site; the /universities contact form is emailed here
CONTACT_EMAIL=Richard.Awe@3d7tech.com
STATIC_DIR=dist
SECURE_COOKIES=true
TRUST_CLOUDFLARE=true
GRADER=on
BACKUP_DIR=/home/gcm/app/shared/backups
# Off-site backups with restic, once you choose storage:
# RESTIC_REPOSITORY=b2:your-bucket:gcm
# RESTIC_PASSWORD=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
